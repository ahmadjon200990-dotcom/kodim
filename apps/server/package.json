{
  "name": "@exam-ide/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @exam-ide/shared build && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "generate": "prisma generate",
    "typecheck": "prisma generate && tsc --noEmit",
    "build": "prisma generate && tsc",
    "migrate": "prisma migrate dev",
    "seed": "pnpm --filter @exam-ide/shared build && tsx src/seed.ts"
  },
  "dependencies": {
    "@exam-ide/shared": "workspace:*",
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^9.1.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  }
}
