generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TeacherRole {
  ADMIN
  TEACHER
}

enum ExamStatus {
  DRAFT
  LOBBY
  RUNNING
  GRADING
  FINISHED
}

enum ExamTemplate {
  EMPTY
  HTML
  REACT_VITE
  VUE_VITE
  TYPESCRIPT
  NODE
  PYTHON
  CUSTOM
}

enum TaskType {
  EXERCISE
  FIGMA
}

enum AttemptStatus {
  JOINED
  WORKING
  SUBMITTED
  ANNULLED
}

enum GradedBy {
  AI
  TEACHER
  NONE
}

enum EventSeverity {
  INFO
  WARN
  DANGER
}

model Teacher {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         TeacherRole @default(TEACHER)
  createdAt    DateTime    @default(now())
  /// Figma Personal Access Token — AES-256-GCM bilan shifrlangan (lib/crypto.ts). Klientga hech qachon yuborilmaydi.
  figmaToken   String?
  /// Token egasining Figma nomi (tekshirilganda /v1/me dan)
  figmaHandle  String?
  /// Google akkaunti (OAuth "sub"); Google orqali kirgan o'qituvchilarda passwordHash bo'sh
  googleId     String?     @unique
  /// Admin o'chirib qo'ygan akkaunt kira olmaydi (ma'lumotlari saqlanadi)
  disabled     Boolean     @default(false)
  lastLoginAt  DateTime?
  exams        Exam[]
  penalties    Penalty[]
  figmaCaches  FigmaCache[]
}

model Exam {
  id              String       @id @default(cuid())
  teacherId       String
  teacher         Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title           String
  /// 6 xonali kod; faqat LOBBY/RUNNING holatida band, keyin null.
  code            String?      @unique
  status          ExamStatus   @default(DRAFT)
  durationMin     Int
  startedAt       DateTime?
  endsAt          DateTime?
  template        ExamTemplate @default(EMPTY)
  /// [{path, content}]
  starterFiles    Json
  /// [{path, content}]
  referenceFiles  Json
  /// [{name, weight, description}]
  criteria        Json
  aiEnabled       Boolean      @default(true)
  /// AiModelTier: DEFAULT | STRONG
  aiModel         String       @default("DEFAULT")
  /// ["react", ...]
  allowedPackages Json
  /// ["npm install", "node", ...] — terminalda ruxsat etilgan buyruq naqshlari
  allowedCommands Json         @default("[]")
  /// ["powershell","cmd","gitbash","wsl"] — ruxsat etilgan terminal profillari (bo'sh — hammasi)
  allowedShells   Json         @default("[]")
  createdAt       DateTime     @default(now())
  tasks           Task[]
  attempts        Attempt[]

  @@index([teacherId])
}

model Task {
  id             String   @id @default(cuid())
  examId         String
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  order          Int
  title          String
  description    String
  type           TaskType
  figmaUrl       String?
  /// [{name, dataUrl}] — yuklangan dizayn rasmlari
  images         Json     @default("[]")
  expectedOutput String?

  @@index([examId, order])
}

model Attempt {
  id              String        @id @default(cuid())
  examId          String
  exam            Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentName     String
  token           String        @unique
  /// Desktop ilova userData dagi doimiy qurilma identifikatori
  deviceId        String?
  status          AttemptStatus @default(JOINED)
  extraMinutes    Int           @default(0)
  connected       Boolean       @default(false)
  lastSeenAt      DateTime      @default(now())
  submittedAt     DateTime?
  /// oxirgi snapshot: [{path, content}]
  files           Json
  aiScore         Int?
  aiResult        Json?
  aiError         String?
  teacherScore    Int?
  teacherComment  String?
  /// o'qituvchi tahrirlagan mezonlar: [{name, weight, score, comment}]
  teacherCriteria Json?
  gradedBy        GradedBy      @default(NONE)
  createdAt       DateTime      @default(now())
  events          Event[]
  penalties       Penalty[]

  @@index([examId])
}

model Event {
  id        String        @id @default(cuid())
  attemptId String
  attempt   Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  type      String
  severity  EventSeverity
  details   Json
  createdAt DateTime      @default(now())
  penalties Penalty[]

  @@index([attemptId, createdAt])
}

model Penalty {
  id        String   @id @default(cuid())
  attemptId String
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([attemptId])
}

/// Figma havolasidan olingan dizayn (o'qituvchi tokeni bilan). Task qayta yaratilsa ham saqlanadi (url bo'yicha).
model FigmaCache {
  id        String       @id @default(cuid())
  teacherId String
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  url       String
  /// PENDING | READY | ERROR
  status    String       @default("PENDING")
  /// Xato kodi (FigmaErrorCode)
  error     String?
  /// FigmaDesign (freymlar va qatlamlar; rasm yo'llari o'quvchi papkasiga yozilganda qo'yiladi)
  data      Json?
  fetchedAt DateTime?
  updatedAt DateTime     @updatedAt
  images    FigmaImage[]

  @@unique([teacherId, url])
}

model FigmaImage {
  id      String     @id @default(cuid())
  cacheId String
  cache   FigmaCache @relation(fields: [cacheId], references: [id], onDelete: Cascade)
  frameId String
  /// png | jpg
  format  String     @default("png")
  scale   Int        @default(2)
  bytes   Bytes

  @@unique([cacheId, frameId])
}
