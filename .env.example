# apps/server/.env uchun namuna
DATABASE_URL="file:./data.db"
JWT_SECRET=change-me
# FAQAT serverda. Desktop ilovada hech qachon bo'lmasin.
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-haiku-5-5
AI_MODEL_STRONG=claude-sonnet-5-5
PORT=8080
ADMIN_EMAIL=admin@kodim.uz
ADMIN_PASSWORD=change-me
# Bazadagi maxfiy qiymatlarni (o'qituvchining Figma tokeni) shifrlash kaliti: openssl rand -base64 32
DATA_ENCRYPTION_KEY=
# Panel va API'ning ommaviy manzili (Google OAuth qaytish manzili shundan)
PUBLIC_URL=http://localhost:8080
# Google OAuth (DEPLOY.md 5-bo'lim). Bo'sh bo'lsa "Google orqali kirish" ko'rinmaydi.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Caddy/Nginx ortida: 1 (X-Forwarded-For dan IP — rate limit uchun)
TRUST_PROXY=0
# Figma REST API (sinovda soxta server: http://127.0.0.1:8090)
# FIGMA_API_BASE=https://api.figma.com

# Desktop build vaqtida
SERVER_URL=http://localhost:8080
