# Supabase active backend configuration
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Frontend env values
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>

# Desktop build-time env values
# Use the same project URL and publishable key as above.
# Optional public app URL for redirects and callbacks.
PUBLIC_URL=http://localhost:5173

# Figma access is meant to be handled in Supabase Edge Functions / secure storage.
# FIGMA_API_BASE=https://api.figma.com
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
