{
  "name": "exam-ide",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "seed": "pnpm --filter @exam-ide/server seed",
    "dev:server": "pnpm --filter @exam-ide/server dev",
    "dev:desktop": "pnpm --filter @exam-ide/desktop dev",
    "start:desktop": "pnpm --filter @exam-ide/desktop build && pnpm --filter @exam-ide/desktop start",
    "dev:panel": "pnpm --filter @exam-ide/panel dev",
    "build:panel": "pnpm --filter @exam-ide/panel build",
    "test": "pnpm -r --if-present test && pnpm test:db",
    "test:db": "node --import ./packages/shared/test/ts-resolve.mjs --test supabase/tests/db.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^9.39.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.19.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
